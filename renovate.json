{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"configMigration": true,
	"extends": ["config:recommended", ":dependencyDashboard", ":prHourlyLimitNone"],
	"packageRules": [
		{
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true,
			"platformAutomerge": true,
			"labels": ["minor", "patch"],
			"ignoreTests": true
		},
		{
			"matchPackageNames": ["astro", "/^@astrojs//"],
			"matchUpdateTypes": ["major"],
			"schedule": ["after 6pm"],
			"labels": ["astro", "major"],
			"automerge": false,
			"ignoreTests": true
		}
	]
}
